# --- Server -------------------------------------------------------------
APP_ENV=development
HOST=127.0.0.1
PORT=8080
# pretty | json  (defaults to json in production)
LOG_FORMAT=pretty
RUST_LOG=querylab_api=debug,tower_http=info,sqlx=warn
REQUEST_TIMEOUT_SECS=120

# --- Metadata database (QueryLab's own data; never used for user SQL) -----
DATABASE_URL=postgres://querylab:querylab@localhost:5432/querylab
DATABASE_MAX_CONNECTIONS=10
RUN_MIGRATIONS=true

# --- Credential encryption (AES-256-GCM) ----------------------------------
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# The value below is for local development only and is rejected when
# APP_ENV=production.
ENCRYPTION_KEY=ngSxD0iS9jusyKYm69L1zh9617mM1Y9WJ8TeX3N0TrU=
ENCRYPTION_KEY_ID=1
# Older keys kept for decryption during rotation: "<id>:<base64>,<id>:<base64>"
# ENCRYPTION_PREVIOUS_KEYS=

# --- Sessions & abuse protection ------------------------------------------
SESSION_TTL_HOURS=168
SESSION_MAX_AGE_DAYS=30
# Defaults to true when APP_ENV=production (Secure + __Host- cookie).
COOKIE_SECURE=false
# Number of reverse proxies in front of the API that append X-Forwarded-For.
TRUSTED_PROXY_HOPS=0
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Target databases (user connections) ----------------------------------
# Development only: lets users connect to localhost / private networks (e.g.
# the docker-compose sample database). Keep false in production (SSRF).
ALLOW_PRIVATE_NETWORKS=true
TARGET_CONNECT_TIMEOUT_SECS=10
TARGET_CONNECT_RATE_LIMIT_PER_MINUTE=60

# --- CORS (comma separated). Not needed when the frontend proxies /api. ---
CORS_ORIGINS=http://localhost:3000
